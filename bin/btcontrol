    try:
        sshport.kill()
        print('super')
    except:
        print('ooper!')
        pass

parser = argparse.ArgumentParser(description='Controls multiple tracking systems.')
parser.add_argument('--scan',help='Refresh the scan cache',action="store_true")
parser.add_argument('--scanports',help='Use inside AWS: Add boxes that connect via ssh to local ports, by scanning a list of port numbers at the provided directory address', type=str,required=False)
parser.add_argument('--openports',help='Use from remote computer: Add boxes that connect via ssh to AWS server, by opening port forwarding to AWS, from list of port numbers at the provided directory address', type=str,required=False)
parser.add_argument('--closeports',help='Close all ports to AWs at end of session',action="store_true")
parser.add_argument('--calconfig',help='Configure exposure, firing rate etc ready for calibration mode',action="store_true")
parser.add_argument('--expconfig',help='Configure exposure, firing rate etc ready for experiment mode',action="store_true")
parser.add_argument('--config',help='Configure exposure: type name of preset configuration as argument',type=str,required=False)
parser.add_argument('--session',help='Set the session id',type=str,required=False)
parser.add_argument('--set',help='Set the set id',type=str,required=False)
parser.add_argument('--start',help='Start all boxes',action="store_true")
parser.add_argument('--stop',help='Start all boxes',action="store_true")
parser.add_argument('--interval',help='Interval in seconds',type=float,required=False)
parser.add_argument('--rsynclocal',help='Location of local destination of rsync, e.g. btcontrol --rsynclocal ~/Documents/beedata',type=str,required=False)
parser.add_argument('--rsync',help='Copy all photos from box to local computer. e.g. btcontrol --rsync --pwfile ~/Documents/Research/rsync_bee/pw.txt',type=str,required=False,nargs='?')
parser.add_argument('--pwfile',help='Configure the path and file containing ssh password.',type=str,required=False)
parser.add_argument('--serveraddress',help='Configure address to remote server. Not needed if all boxes are on local network.',type=str,required=False)
parser.add_argument('--serverpw',help='Configure the path and file containing ssh key for remote server.',type=str,required=False)
parser.add_argument('--reboot',help='Reboot the pi',action="store_true")
args = parser.parse_args()

configpath = os.path.expanduser('~')+'/.btcontrol/'
os.makedirs(configpath,exist_ok=True)

if args.interval:
    interval = args.interval
else:
    interval = 0.5

#Now that there are 3 ways to generate a box list, it's inelegant to deal with a lack of input under each relevant arg, 
#because we'll generate 3 different messages (and will call sys.exit even though the other arg provides the necessary info to generate a new box list).
#Instead we check whether there's a box list here and return a single error message if not.
if not args.scan and not args.scanports and not args.openports:
    try:
        boxes = pickle.load(open(configpath+'cached_boxes.pkl','rb'))
    except:
        print("No boxes specified. Use --scan OR --scanports OR --openports")
        sys.exit(1)
        
ipaddr = get_ip()
if args.scan: 
    boxes = []
    for i in range(3):
        print("Rescanning... %d/3\n" % (i+1))
        boxes = scan_our_subnet(ipaddr,boxes)
    pickle.dump(boxes,open(configpath+'cached_boxes.pkl','wb'))
#else:
#    try:
#        boxes = pickle.load(open(configpath+'cached_boxes.pkl','rb'))
 #   except:
#        print("Cache not found, need to scan. Use --scan") #Replaced with message above
#        sys.exit(1)

#QUESTION: should we cache the lists of ports so that we can subsequently call --scanports with no arguments and rescan the cached list? Would allow us to check again if a box has rebooted, but seems unnecessary since there's no obvious cost to just repassing the original boxlist if you want to do that
if args.scanports is not None:
    boxes = [] #QUESTION: in the scan command, we clear the list of boxes before scanning so we don't end up having boxes on our list that are no longer online. I've done the same here. BUT this means that we can't combine 'scan' and 'scanports'. I can't imagine why we'd ever want to control a list of boxes some of which are on the local network and others connecting by ssh, but if we do, we'll need a way to combine the two methods without overwriting our list of boxes
    listofsshports, listofAPIports, listofwebinterfaceports = filenametoportlist(args.scanports)
    boxes =  addlocalportconnections(listofsshports,listofAPIports,listofwebinterfaceports,boxes)  
    pickle.dump(boxes,open(configpath+'cached_boxes.pkl','wb'))
#else: #QUESTION: I'm following --scan and looking for a cache of boxes, but perhaps we should instead cache the list of ports, so that we can recheck the list each time, in case some boxes have connected or disconnected?
#    try:
#        boxes = pickle.load(open(configpath+'cached_boxes.pkl','rb'))
#    except:
#        print("Cache not found, need list of boxes. Use --scanports FILE_WITH_PORT_LIST") #Replaced with message above#
#        sys.exit(1)

if args.serveraddress is not None:
    print("Setting server address: %s" % args.serveraddress)
    serveraddress = args.serveraddress
else:
    try:
        serveraddress = pickle.load(open(configpath+'cached_serveraddress.pkl','rb'))
    except:
        serveraddress = ""        
pickle.dump(serveraddress,open(configpath+'cached_serveraddress.pkl','wb')) 

if args.serverpw is not None:
    print("Password file for server: %s" % args.serverpw)
    serverpw = args.serverpw
else:
    try:
        serverpw = pickle.load(open(configpath+'cached_serverpw.pkl','rb'))
    except:
        serverpw = None      
pickle.dump(serverpw,open(configpath+'cached_serverpw.pkl','wb'))

if args.openports is not None: #QUESTION: Please check that this command and associated "openportconnections" function are not a Very Bad Idea before I go and start using them!
    boxes = [] #QUESTION: in the scan command, we clear the list of boxes before scanning so we don't end up having boxes on our list that are no longer online. I've done the same here. BUT this means that we can't combine 'scan' and 'scanports'. I can't imagine why we'd ever want to control a list of boxes some of which are on the local network and others connecting by ssh, but if we do, we'll need a way to combine the two methods without overwriting our list of boxes
    try:
        openportlist = pickle.load(open(configpath+'cached_ports.pkl','rb'))
    except:
        openportlist=[]
    listofsshports, listofAPIports, listofwebinterfaceports = filenametoportlist(args.openports)
    boxes, openportlist =  openportconnections(serveraddress, serverpw, listofsshports,listofAPIports,listofwebinterfaceports,boxes,openportlist)  
    pickle.dump(boxes,open(configpath+'cached_boxes.pkl','wb'))
    pickle.dump(openportlist,open(configpath+'cached_ports.pkl','wb'))
#else: #QUESTION: I'm following --scan and looking for a cache of boxes, but perhaps we should instead cache the list of ports, so that we can recheck the list each time, in case some boxes have connected or disconnected?
#    try:
#        boxes = pickle.load(open(configpath+'cached_boxes.pkl','rb'))
#    except:
#        print("Cache not found, need list of boxes. Use --openports FILE_WITH_PORT_LIST") #Replaced with message above
#        sys.exit(1)

if args.session is not None:
    print("Setting new session id: %s" % args.session)
    sessionid = args.session
else:
    try:
        sessionid = pickle.load(open(configpath+'cached_sessionid.pkl','rb'))
    except:
        print("WARNING: NO SESSION ID SET, use --session IDOFSESSION")
        sessionid = "unnamed_session"
  
if args.pwfile is not None:
    print("Password file: %s" % args.pwfile)
    pwfile = args.pwfile
else:
    try:
        pwfile = pickle.load(open(configpath+'cached_pwfile.pkl','rb'))
    except:
        pwfile = None
pickle.dump(pwfile,open(configpath+'cached_pwfile.pkl','wb'))    
      
if args.rsynclocal is not None:
    print("Local destination: %s" % args.rsynclocal)
    rsynclocal = args.rsynclocal
else:
    try:
        rsynclocal = pickle.load(open(configpath+'cached_rsynclocal.pkl','rb'))
    except:
        rsynclocal = "."        
pickle.dump(rsynclocal,open(configpath+'cached_rsynclocal.pkl','wb'))    


if args.set is not None:
    print("Setting new set id: %s" % args.set)
    setid = args.set
else:
    try:
        setid = pickle.load(open(configpath+'cached_setid.pkl','rb'))
    except:
        print("WARNING: NO SET ID SET, use --set IDOFSET")
        setid = "unnamed_set"
    
print("SESSION: %s" % sessionid)
print("SET: %s" % setid)

if args.stop:
    for box in boxes:
        box.stop()     
        
if args.reboot:
    for box in boxes:
        box.reboot()     

if args.calconfig:
    print("Reminder: Setting set to 'cal'")
    setid = 'cal'
    for box in boxes:
        box.configure('cal')
        
if args.expconfig:  
    beeboxes = [box for box in boxes if box.beebox]  
    for i,box in enumerate(beeboxes):
        box.configure('exp',i/len(beeboxes),interval)

if args.config is not None:
    confname=args.config
    beeboxes = [box for box in boxes if box.beebox]  
    for i,box in enumerate(beeboxes):
        box.configure(confname,i/len(beeboxes),2)
        
for box in boxes:
    box.sessionset(sessionid,setid)

        
if args.start:
    for box in boxes:
        box.start()
   

if args.rsync is not None: #QUESTION: I don't think rsync will currently work with boxes connecting via local ports, because it tries to SSH to each Pi's IP address. I can figure out how to do it across the SSH tunnel instead, but is it worth doing? If we are controlling boxes using AWS then we will also be backing up the data using Joe H's pipeline and won't need to rsync
    os.makedirs(rsynclocal,exist_ok=True)
    for box in boxes:
        box.rsync(pwfile,rsynclocal,args.rsync)        

if args.closeports:
    if not openportlist:
        try:
            openportlist = pickle.load(open(configpath+'cached_ports.pkl','rb'))
        except:
            print("No open ports found")
            continue
    for openport in openportlist:
    try:
        openport.kill()
#        print('super')
    except:
#        print('ooper!')
        pass
    openportlist=[]
    pickle.dump(openportlist,open(configpath+'cached_ports.pkl','wb'))

pickle.dump(sessionid,open(configpath+'cached_sessionid.pkl','wb'))    
pickle.dump(setid,open(configpath+'cached_setid.pkl','wb'))    

 
print("Our IP address: %s" % ipaddr)
print("")
print("                 IP Address    | Port 22 | Port 5k | Comments        | Last Command")
for box in boxes:    
    #if not box.beebox: continue #only will show bee boxes.
    box.display()
    
